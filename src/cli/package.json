{
  "name": "vork-cli",
  "version": "1.0.3",
  "description": "Vork CLI - Agente multimodal y de programación para la terminal con IA soberana y gratuita, rotación inteligente de modelos, herramientas autónomas, MCP, LSP y pilares multimedia.",
  "keywords": [
    "vork",
    "vork-cli",
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "llm",
    "free",
    "terminal",
    "spanish",
    "free-llm",
    "ai-agent",
    "coding-assistant",
    "openai-compatible",
    "openrouter",
    "gemini",
    "mcp",
    "agent-skills"
  ],
  "homepage": "https://github.com/MiguelCarlosRojas/Vork#readme",
  "bugs": {
    "url": "https://github.com/MiguelCarlosRojas/Vork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiguelCarlosRojas/Vork.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Miguel Angel Carlos Rojas (Vork Technologies)",
  "type": "module",
  "bin": {
    "vork": "dist/index.js",
    "vork-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --test-force-exit --test-timeout=120000 \"test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cross-spawn": "^7.0.6",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.12.0",
    "ink": "^8.0.0",
    "marked": "^18.1.2",
    "openai": "^7.45.1",
    "picocolors": "^1.1.1",
    "react": "^19.3.1",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "vork": "file:../..",
    "wrap-ansi": "^10.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
